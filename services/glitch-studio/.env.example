GLITCH_HOST=127.0.0.1
GLITCH_PORT=4319
GLITCH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Absolute path to a Chrome/Chromium executable, or leave empty for installed Chrome.
GLITCH_BROWSER_PATH=
# Alternatively use chromium after: npx playwright-core install chromium
GLITCH_BROWSER_CHANNEL=chrome
# FFmpeg must include the libx264 encoder.
GLITCH_FFMPEG_PATH=ffmpeg
# Persistent private directory; defaults to services/glitch-studio/.data.
GLITCH_DATA_DIR=
# Set to 1 only behind exactly one trusted reverse proxy that overwrites forwarded IPs.
GLITCH_TRUST_PROXY=0
