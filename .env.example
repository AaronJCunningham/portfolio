# Shop — server-only values. Copy into .env.local or your host's environment settings.
# Or run npm run shop:prepare to preserve existing settings and generate local secrets.
# npm run shop:check lists remaining setup; docs/checkout.md has the account checklist.
# Keep checkout off until configured. Never commit real credentials.
SHOP_CHECKOUT_ENABLED=false
SHOP_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful private token for your Manual order / API store.
PRINTFUL_TOKEN=
# Optional for a store-scoped token; required for an account-scoped token.
PRINTFUL_STORE_ID=
# Stripe test payments skip Printful by default. Enable only to create real, uncharged drafts.
PRINTFUL_TEST_DRAFTS=false

# Optional destination allowlist. Empty means ask Printful for every destination.
SHOP_SHIPPING_COUNTRIES=
# Connected checkout uses Stripe Tax with your configured registrations/settings.
SHOP_TAX_MODE=automatic
# A random server secret of at least 32 characters to protect expiring order quotes.
SHOP_QUOTE_SECRET=
# Optional override; everyday clothing defaults to txcd_30011000.
STRIPE_PRODUCT_TAX_CODE=
# Additional gate for live Stripe keys. Set only after test checkout and launch review.
SHOP_LIVE_READY=false

# Decorated Printful sync variant IDs. Copy from your API store; leave blank until known.
PRINTFUL_POLO_S=
PRINTFUL_POLO_M=
PRINTFUL_POLO_L=
PRINTFUL_POLO_XL=
PRINTFUL_POLO_2XL=
PRINTFUL_POLO_3XL=
PRINTFUL_POLO_4XL=
PRINTFUL_POLO_5XL=
# Classic: Cotton Heritage M2480, 288.2 g/m².
PRINTFUL_SWEATSHIRT_CLASSIC_S=
PRINTFUL_SWEATSHIRT_CLASSIC_M=
PRINTFUL_SWEATSHIRT_CLASSIC_L=
PRINTFUL_SWEATSHIRT_CLASSIC_XL=
PRINTFUL_SWEATSHIRT_CLASSIC_2XL=
PRINTFUL_SWEATSHIRT_CLASSIC_3XL=
# Heavyweight: Stanley/Stella STSU178, 350 g/m².
PRINTFUL_SWEATSHIRT_HEAVYWEIGHT_S=
PRINTFUL_SWEATSHIRT_HEAVYWEIGHT_M=
PRINTFUL_SWEATSHIRT_HEAVYWEIGHT_L=
PRINTFUL_SWEATSHIRT_HEAVYWEIGHT_XL=
PRINTFUL_SWEATSHIRT_HEAVYWEIGHT_2XL=

# Customer shipping emails. Disabled locally; no email is sent until explicitly enabled.
SHOP_EMAIL_ENABLED=false
RESEND_API_KEY=
SHOP_EMAIL_FROM=LVX <info@aaronjcunningham.com>
# Random secret, at least 32 characters, for the private Printful v1 webhook URL.
PRINTFUL_WEBHOOK_SECRET=
